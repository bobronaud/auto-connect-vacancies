{
  "name": "auto-connect-vacancies",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CLI для сбора заказов Connect и откликов через Telegram Web",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts --format esm --out-dir dist --clean",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "browser:install": "node scripts/install-browser.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:secrets:staged": "node scripts/check-secrets.mjs --staged"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.4",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.64.1",
    "smol-toml": "^1.9.1",
    "undici": "7.30.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
